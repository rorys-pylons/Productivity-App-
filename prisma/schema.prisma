// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Valley {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique @default(cuid())
  createdAt  DateTime @default(now())
  players    Player[]
  wheels     Wheel[]
}

model Player {
  id         String      @id @default(cuid())
  valleyId   String      @default("valley-genesis")
  valley     Valley      @relation(fields: [valleyId], references: [id], onDelete: Cascade)
  name       String
  color      String      @default("#6366f1")
  points     Int         @default(0)
  createdAt  DateTime    @default(now())
  tasks      Task[]
  spins      SpinLog[]
  broadcasts Broadcast[]

  @@unique([valleyId, name])
}

model Task {
  id          String    @id @default(cuid())
  playerId    String
  player      Player    @relation(fields: [playerId], references: [id])
  title       String
  minutes     Int
  dread       Int
  points      Int
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model SpinLog {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  cost      Int
  reward    String
  createdAt DateTime @default(now())
}

model Wheel {
  id        String         @id @default(cuid())
  valleyId  String         @default("valley-genesis")
  valley    Valley         @relation(fields: [valleyId], references: [id], onDelete: Cascade)
  name      String
  kind      String         @default("custom")
  createdAt DateTime       @default(now())
  segments  WheelSegment[]
}

model WheelSegment {
  id          String @id @default(cuid())
  wheelId     String
  wheel       Wheel  @relation(fields: [wheelId], references: [id], onDelete: Cascade)
  label       String
  color       String
  bonusPoints Int    @default(0)
  weight      Int    @default(10)
  order       Int    @default(0)
}

model Broadcast {
  id           String   @id @default(cuid())
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id])
  week         String
  frequency    Int
  transmission String
  createdAt    DateTime @default(now())

  @@unique([playerId, week])
}
